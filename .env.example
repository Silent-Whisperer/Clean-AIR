# ClearAir Configuration
PORT=3001
NODE_ENV=development

# Real GenAI API Integration (OpenRouter or Google Gemini)
# Add your OpenRouter API Key below (e.g. sk-or-v1-...)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Gemini API Key (alternative)
GEMINI_API_KEY=

# Air Quality API Timeout (milliseconds)
AI_TIMEOUT_MS=25000

# Google Maps API Key for Geocoding & High-Accuracy Location Resolution
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
